# @dialect: AGENTFABRIC=1.1
#
# Max Securities (fictional) Account Opening Broker
#
# One turn. The rules (max-core, max/kyc.dwl) open clean applications without anyone; only flagged ones come here.
# The agent reviews and drafts; an employee decides in the approval inbox (Salesforce). The decision opens or rejects the account.
#
#   "申込み OA-0003 を調べて"
#   trigger -> subagent classify (no tools) -> router
#     + review       -> subagent review (get-application: application, findings, similar customers, watch list; one call)
#                       -> router statusRouter (not found / already pending / already decided)
#                       -> executor requestApproval (request-account-approval, no LLM) -> generator reply -> echo
#     + list         -> subagent listApplications (list-applications) -> echo
#
# Same design notes as demos/max-securities/max-surveillance.

system:
  instructions: "あなたは証券会社の口座開設の審査の補助です。確認できた事実だけを扱い、推測で埋めません。最終判断は必ず担当者が承認箱で行います。"

config:
  agent_name: "Max Securities Account Opening Broker{{-suffix}}"
  default_llm: @llm.openai_llm

llm:
  openai_llm:
    target: "llm://max_ops_openai_connection{{_suffix}}"
    kind: "OpenAI"
    model: "gpt-5-mini"
    reasoning_effort: "LOW"

actions:
  list_applications:
    target: "mcp://max_operations_connection{{_suffix}}"
    kind: "mcp:tool"
    tool_name: "list-applications"

  get_application:
    target: "mcp://max_operations_connection{{_suffix}}"
    kind: "mcp:tool"
    tool_name: "get-application"

  request_account_approval:
    target: "mcp://max_operations_connection{{_suffix}}"
    kind: "mcp:tool"
    tool_name: "request-account-approval"

trigger operationsTrigger:
  kind: "a2a"
  target: "brokers://max-operations-broker{{-suffix}}/a2a"
  on_message: ->
    transition to @subagent.classify

subagent classify:
  label: "Classify Request"
  description: "Classifies the message: review one application, or list the applications."
  system:
    instructions: |
      あなたは受付担当です。メッセージから申込みの ID を取り出す。
      「OA-」に続く数字、または単独の 1〜4 桁の数字が申込みの ID。applicationId は必ず "OA-0001" の形 (4 桁) に正規化する。
      見つかれば route_key = "review"。ID が無い場合 (「一覧」「確認待ちは？」など) は route_key = "list_applications"。
      確認待ちだけを見たいと書かれていれば statusFilter = "確認待ち" (承認待ち・口座開設・否認・追加確認も同様)、それ以外は空文字。
      使わない項目は空文字にする。
      ★★ 最重要: あなたは人間に話しかけてはいけません。質問文・確認文・実況を出力すると処理が中断されます。
         どんな場合も構造化出力だけを返してください。
  reasoning:
    instructions: ->
      | メッセージ: {!@request.payload.message.parts[0].text}
      | route_key / applicationId / statusFilter の構造化出力だけを返すこと。
    outputs:
      properties:
        route_key:
          type: "string"
          description: "Next route"
          enum:
            - "review"
            - "list_applications"
        applicationId:
          type: "string"
          description: "Normalized application ID such as OA-0001, or empty"
        statusFilter:
          type: "string"
          description: "Status to list, or empty for all"
    max_number_of_loops: 2
    max_consecutive_errors: 2
    task_timeout_secs: 40
  on_exit: ->
    transition to @router.mainRouter

router mainRouter:
  description: "Branches on the classified route."
  routes:
    - target: @subagent.review
      when: @subagent.classify.output.route_key == "review"
      label: "Review"
    - target: @subagent.listApplications
      when: @subagent.classify.output.route_key == "list_applications"
      label: "List the applications"
  otherwise:
    target: @echo.classifyFailed

subagent review:
  label: "Review Application"
  description: "Reads the application bundle and drafts a recommendation."
  system:
    instructions: |
      あなたは口座開設の申込みの審査を行います。規則に引っかかった申込みだけがここに来ます。
      1. get_application を 1 回だけ呼ぶ (申込みの中身、規則の引っかかり、名前の似た既存のお客さま、要注意リストの該当が 1 回で返る)。
         found が false なら found = "false" とし、他の項目は空文字にして、以降は何もせず返す。
      2. applicationStatus には get_application の status をそのまま入れる。
      3. 推奨を 1 つ決める:
         - 引っかかりが説明のつくもの (要注意リストの部分一致で生年月日も違う別人など) で、ほかに問題が無い → "承認"
         - 既存のお客さまとの重複 (同じ人の二重の口座)、適合性を明らかに欠く (高齢・未経験で高リスクを望み、資産の大半を入れるなど) → "否認"
         - 資金の出どころや本人の確認など、聞き取りや書類で確かめれば判断できる → "追加確認"
         推奨は下書きであり、最終判断は担当者が行う。
      出力 (どれも get_application の値だけを使い、無い事実を足さない):
      - facts: 申込者の属性 (年齢・職業・年収・投資経験・希望するリスク・入れる予定の金額) を 2〜4 行で。
      - findings: 規則の引っかかりを 1 行 1 件で、それぞれについて分かったこと (要注意リストの生年月日、重複の相手など) を添えて。
      - gaps: 確認できなかった材料 (無ければ "なし")。
      - reasoning: 推奨の根拠を 2〜4 文で。
      ★★ 最重要: あなたは人間に話しかけてはいけません。質問文・確認文・実況を出力すると処理が中断されます。
         どんな場合も構造化出力だけを返してください。
  reasoning:
    instructions: ->
      | applicationId: {!@subagent.classify.output.applicationId}
    actions:
      get_application: @actions.get_application
    outputs:
      properties:
        found:
          type: "string"
          description: "\"true\" when the application exists, otherwise \"false\""
        applicationId:
          type: "string"
          description: "The application ID"
        applicationStatus:
          type: "string"
          description: "The application's status as returned by get_application"
        applicantName:
          type: "string"
          description: "Applicant name"
        recommendation:
          type: "string"
          description: "承認, 否認 or 追加確認"
          enum:
            - "承認"
            - "否認"
            - "追加確認"
        facts:
          type: "string"
          description: "The applicant, 2 to 4 lines"
        findings:
          type: "string"
          description: "The rule findings with what was found, one per line"
        gaps:
          type: "string"
          description: "What could not be checked, or なし"
        reasoning:
          type: "string"
          description: "Why this recommendation"
    max_number_of_loops: 4
    max_consecutive_errors: 2
    task_timeout_secs: 150
  on_exit: ->
    transition to @router.statusRouter

router statusRouter:
  description: "Stops when the application does not exist, already waits for approval, or is already decided."
  routes:
    - target: @echo.notFound
      when: @subagent.review.output.found == "false"
      label: "Not found"
    - target: @echo.alreadyPending
      when: @subagent.review.output.applicationStatus == "承認待ち"
      label: "Already waiting for approval"
    - target: @echo.alreadyDecided
      when: @subagent.review.output.applicationStatus == "口座開設"
      label: "Already opened"
    - target: @echo.alreadyDecided
      when: @subagent.review.output.applicationStatus == "否認"
      label: "Already rejected"
    - target: @echo.alreadyDecided
      when: @subagent.review.output.applicationStatus == "追加確認"
      label: "Already sent back for more"
  otherwise:
    target: @executor.requestApproval

executor requestApproval:
  description: "Saves the review and sends the recommendation with the memo to the approval inbox."
  do: ->
    run @actions.request_account_approval
      with contextId = @request.payload.message.contextId
      with applicationId = @subagent.review.output.applicationId
      with recommendation = @subagent.review.output.recommendation
      with facts = @subagent.review.output.facts
      with findings = @subagent.review.output.findings
      with gaps = @subagent.review.output.gaps
      with reasoning = @subagent.review.output.reasoning
  on_exit: ->
    transition to @generator.reply

generator reply:
  system:
    instructions: "あなたは口座開設の審査の補助です。担当者が読む審査メモの下書きを Markdown で書きます。確認できた事実だけを使い、材料にない事実を足しません。前置き・実況は書きません。"
  prompt: ->
    | 次の材料から審査メモの下書きを作ってください。1 行目は「### 🗂 口座開設の審査メモ（下書き）: <申込み ID> <申込者>」とします。
    | 見出しは順に「申込者」「規則の引っかかり」「確認できなかった材料」「推奨（下書き）」。
    | 最後に次の 2 行を必ずそのまま付けます:
    | ---
    | **承認箱 (Salesforce の「承認依頼」) に回しました。** 判断は承認箱で担当者が行います。
    |
    | 申込み ID: {!@subagent.review.output.applicationId}
    | 申込者: {!@subagent.review.output.applicantName}
    | 申込者の属性: {!@subagent.review.output.facts}
    | 規則の引っかかり: {!@subagent.review.output.findings}
    | 確認できなかった材料: {!@subagent.review.output.gaps}
    | 推奨: {!@subagent.review.output.recommendation}
    | 根拠: {!@subagent.review.output.reasoning}
  on_exit: ->
    transition to @echo.memoStatus

echo memoStatus:
  label: "Memo sent to the approval inbox"
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart(@generator.reply.output)
    ]
  })

echo notFound:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_FAILED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("申込み " + @subagent.classify.output.applicationId + " は見つかりませんでした。申込みの ID（例: OA-0001）を確かめてください。")
    ]
  })

echo alreadyPending:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("申込み " + @subagent.review.output.applicationId + " は、すでに承認箱で担当者の判断を待っています。")
    ]
  })

echo alreadyDecided:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("申込み " + @subagent.review.output.applicationId + " は判断済みです（" + @subagent.review.output.applicationStatus + "）。")
    ]
  })

subagent listApplications:
  label: "List Applications"
  description: "Lists the applications so the human can pick one."
  system:
    instructions: |
      list_applications を 1 回呼び、結果を Markdown の表にして table に入れる。
      表の列は「申込み ID | 申込日 | 申込者 | 状態 | 規則の引っかかり」。値はツールの結果をそのまま使い、並び順も変えない。
      申込みが 0 件なら table に「該当する申込みはありません。」とだけ入れる。
      ★★ 最重要: あなたは人間に話しかけてはいけません。table の構造化出力だけを返してください。
  reasoning:
    instructions: ->
      | status: {!@subagent.classify.output.statusFilter}
    actions:
      list_applications: @actions.list_applications
    outputs:
      properties:
        table:
          type: "string"
          description: "The applications as a Markdown table"
    max_number_of_loops: 3
    max_consecutive_errors: 2
    task_timeout_secs: 40
  on_exit: ->
    transition to @echo.applicationList

echo applicationList:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("### 🗂 口座開設の申込み\n\n" + @subagent.listApplications.output.table + "\n\n調べたい申込みの ID を送ってください（例: 申込み OA-0003 を調べて）。")
    ]
  })

echo classifyFailed:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_FAILED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("依頼の内容を判定できませんでした。申込みの ID（例: OA-0001）を添えてもう一度送ってください。")
    ]
  })

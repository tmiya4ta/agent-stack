%%% request GET :18479/k/test-key/
%%% response 200
content-type: text/html

<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- 鍵が経路に入っているので、Referer で外に出さない -->
<meta name="referrer" content="no-referrer">
<title>マックス証券 注文</title>
<style>
  :root { --bg: #f7f7f5; --fg: #1d1d1b; --muted: #6b6b66; --line: #dcdcd6; --accent: #0b5cad; --buy: #b42318; --sell: #1f6f43; --card: #ffffff; }
  @media (prefers-color-scheme: dark) { :root { --bg: #161615; --fg: #ecece8; --muted: #a3a39c; --line: #3a3a37; --accent: #6aa8f0; --buy: #f07a6e; --sell: #6fcf97; --card: #20201e; } }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.6 system-ui, "Hiragino Sans", "Noto Sans JP", sans-serif; }
  main { max-width: 720px; margin: 0 auto; padding: 20px 16px 48px; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: var(--muted); margin: 0 0 20px; font-size: 13px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
  label { display: block; font-size: 13px; color: var(--muted); margin: 10px 0 4px; }
  select, input { width: 100%; padding: 9px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); font: inherit; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sides { display: flex; gap: 8px; margin-top: 4px; }
  .sides button { flex: 1; padding: 9px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); font: inherit; cursor: pointer; }
  .sides button[aria-pressed="true"].buy { background: var(--buy); color: #fff; border-color: var(--buy); }
  .sides button[aria-pressed="true"].sell { background: var(--sell); color: #fff; border-color: var(--sell); }
  .submit { margin-top: 16px; width: 100%; padding: 11px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .submit:disabled { opacity: .5; cursor: default; }
  .est { color: var(--muted); font-size: 13px; margin-top: 8px; }
  .msg { margin-top: 12px; font-size: 14px; }
  .msg.err { color: var(--buy); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 6px 4px; border-bottom: 1px solid var(--line); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .note { color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<main>
  <h1>マックス証券 注文</h1>
  <p class="sub">架空の証券会社のデモです。名前・銘柄・値段はすべて作りものです。<span id="today"></span></p>

  <section class="card">
    <label for="customer">お客さま</label>
    <select id="customer"></select>
    <label for="code">銘柄</label>
    <select id="code"></select>
    <div class="row">
      <div>
        <label>売買</label>
        <div class="sides">
          <button type="button" class="buy" data-side="買" aria-pressed="true">買</button>
          <button type="button" class="sell" data-side="売" aria-pressed="false">売</button>
        </div>
      </div>
      <div>
        <label for="qty">株数 (100 株単位)</label>
        <input id="qty" type="number" min="100" step="100" value="100">
      </div>
    </div>
    <div class="est" id="est"></div>
    <button class="submit" id="submit">注文する</button>
    <div class="msg" id="msg" role="status"></div>
  </section>

  <section class="card">
    <strong>きょうの注文</strong>
    <table>
      <thead><tr><th>約定</th><th>お客さま</th><th>銘柄</th><th>売買</th><th class="num">株数</th><th class="num">単価</th></tr></thead>
      <tbody id="orders"></tbody>
    </table>
    <p class="note">注文はその日の終値で約定し、約定は Anypoint MQ で台帳に届きます。売買審査は毎日の終わりに回ります。</p>
  </section>
</main>
<script>
const $ = (id) => document.getElementById(id);
let market = null, side = "買";
const yen = (n) => Number(n).toLocaleString("ja-JP");
function opt(v, t) { const o = document.createElement("option"); o.value = v; o.textContent = t; return o; }
function estimate() {
  const i = market && market.instruments.find((x) => x.code === $("code").value);
  const q = Number($("qty").value);
  $("est").textContent = i && q > 0 ? `終値 ${yen(i.close)} 円 × ${yen(q)} 株 = 約 ${yen(Math.round(i.close * q))} 円` : "";
}
async function loadOrders() {
  const r = await fetch("orders/today");
  const rows = r.ok ? await r.json() : [];
  const tb = $("orders"); tb.replaceChildren();
  for (const o of rows) {
    const tr = document.createElement("tr");
    for (const [v, num] of [[o.tradeId], [o.customerName], [o.instrumentName], [o.side], [yen(o.qty), 1], [yen(o.price), 1]]) {
      const td = document.createElement("td"); td.textContent = v; if (num) td.className = "num"; tr.appendChild(td);
    }
    tb.appendChild(tr);
  }
}
async function load() {
  const r = await fetch("market");
  if (!r.ok) { $("msg").textContent = "読み込めませんでした。"; $("msg").className = "msg err"; return; }
  market = await r.json();
  $("today").textContent = ` 業務日: ${market.today}`;
  for (const c of market.customers) $("customer").appendChild(opt(c.customerId, `${c.customerId} ${c.name}`));
  for (const i of market.instruments) $("code").appendChild(opt(i.code, `${i.code} ${i.name} (${yen(i.close)} 円)`));
  estimate(); loadOrders();
}
document.querySelectorAll(".sides button").forEach((b) => b.addEventListener("click", () => {
  side = b.dataset.side;
  document.querySelectorAll(".sides button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
}));
$("code").addEventListener("change", estimate);
$("qty").addEventListener("input", estimate);
$("submit").addEventListener("click", async () => {
  $("submit").disabled = true; $("msg").textContent = ""; $("msg").className = "msg";
  try {
    const r = await fetch("orders", { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ customer_id: $("customer").value, code: $("code").value, side, qty: Number($("qty").value), channel: "ネット" }) });
    const d = await r.json();
    if (!r.ok) { $("msg").textContent = d.error || "注文できませんでした。"; $("msg").className = "msg err"; }
    else { $("msg").textContent = `約定しました: ${d.tradeId} ${d.side} ${yen(d.qty)} 株 @ ${yen(d.price)} 円`; loadOrders(); }
  } catch (e) { $("msg").textContent = "注文できませんでした。"; $("msg").className = "msg err"; }
  $("submit").disabled = false;
});
load();
</script>
</body>
</html>


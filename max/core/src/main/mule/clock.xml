<?xml version="1.0" encoding="UTF-8"?>
<!--
  仮想の業務時計。業務の日付はいつも business_clock から読む (壁の時計は監査ログの時刻にだけ使う)。
    GET  /clock             いまの業務日
    POST /clock/auto        自動で進めるか {enabled, until}。clock.auto.interval ごとに 1 営業日 (until の日まで)
    POST /clock/advance     次の営業日へ進める (?days=1..20。自動で進めている最中なら 409)。1 日ごとに:
                              終値 (max/market.dwl)、普段の売買と仕込んだ注文を OMS (oms.url) へ (約定は MQ で台帳に届くのを待つ)、
                              その日の公表 (planned_events から)、
                              時計を進め、点数付けを回す (できたアラートは調査エージェントへ)
  同じデータから同じ日に進めれば、同じ終値・同じ約定・同じアラートになる。
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <flow name="clock-get">
        <http:listener config-ref="Http" path="/clock" allowedMethods="GET">
            <http:response statusCode="#[vars.status default 200]"/>
        </http:listener>
        <flow-ref name="auth"/>
        <db:select config-ref="Db">
            <db:sql>select to_char(today, 'YYYY-MM-DD') as today, auto, to_char(auto_until, 'YYYY-MM-DD') as auto_until, busy from max.business_clock</db:sql>
        </db:select>
        <set-payload value="#[output application/json --- {today: payload[0].today,
            nextBusinessDay: max::market::nextBusinessDay(payload[0].today as Date) as String,
            auto: payload[0].auto, autoUntil: payload[0].auto_until, busy: payload[0].busy}]"/>
        <error-handler>
            <on-error-continue>
                <flow-ref name="error-body"/>
            </on-error-continue>
        </error-handler>
    </flow>

    <flow name="clock-advance">
        <http:listener config-ref="Http" path="/clock/advance" allowedMethods="POST">
            <http:response statusCode="#[vars.status default 200]"/>
        </http:listener>
        <flow-ref name="auth"/>
        <set-variable variableName="n" value="#[(attributes.queryParams.days default '1') as Number default 0]"/>
        <choice>
            <when expression="#[vars.n &lt; 1 or vars.n &gt; 20]">
                <raise-error type="MAX:BAD_REQUEST" description="days must be 1 to 20"/>
            </when>
        </choice>
        <flow-ref name="clock-acquire"/>
        <choice>
            <when expression="#[not vars.acquired]">
                <raise-error type="MAX:CONFLICT" description="The clock is being advanced (try again later)"/>
            </when>
        </choice>
        <set-variable variableName="report" value="#[[]]"/>
        <foreach collection="#[1 to vars.n]">
            <flow-ref name="advance-one-day"/>
            <set-variable variableName="report" value="#[vars.report + payload]"/>
        </foreach>
        <flow-ref name="clock-release"/>
        <set-payload value="#[output application/json --- {days: vars.report}]"/>
        <error-handler>
            <on-error-continue>
                <flow-ref name="clock-release"/>
                <flow-ref name="error-body"/>
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- 進めている最中の印を取る (vars.acquired)。手と自動が重ならないように -->
    <sub-flow name="clock-acquire">
        <db:update config-ref="Db">
            <!-- 10 分より古い印は、進めている途中で止まったプロセスの残り (再配備など) なので取り直す -->
            <db:sql>update max.business_clock set busy = true, busy_since = now()
                    where busy = false or busy_since is null or busy_since &lt; now() - interval '10 minutes'</db:sql>
        </db:update>
        <set-variable variableName="acquired" value="#[payload.affectedRows == 1]"/>
    </sub-flow>

    <!-- 自分が取った印だけを返す -->
    <sub-flow name="clock-release">
        <choice>
            <when expression="#[vars.acquired default false]">
                <db:update config-ref="Db" target="released">
                    <db:sql>update max.business_clock set busy = false, busy_since = null</db:sql>
                </db:update>
                <set-variable variableName="acquired" value="#[false]"/>
            </when>
        </choice>
    </sub-flow>

    <!-- 自動で進めるかと、どの日まで進めるか。{enabled: true|false, until: "yyyy-MM-dd" (無ければ限りなく)} -->
    <flow name="clock-auto-set">
        <http:listener config-ref="Http" path="/clock/auto" allowedMethods="POST">
            <http:response statusCode="#[vars.status default 200]"/>
        </http:listener>
        <flow-ref name="auth"/>
        <set-variable variableName="req" value="#[output application/java --- payload]"/>
        <choice>
            <when expression="#[not ((vars.req.enabled default null) is Boolean)]">
                <raise-error type="MAX:BAD_REQUEST" description="enabled must be true or false"/>
            </when>
            <when expression="#[(vars.req.until default null) != null and not ((vars.req.until as String) matches /\d{4}-\d{2}-\d{2}/)]">
                <raise-error type="MAX:BAD_REQUEST" description="until must be yyyy-MM-dd"/>
            </when>
        </choice>
        <db:update config-ref="Db">
            <db:sql>update max.business_clock set auto = :enabled, auto_until = cast(:until as date)</db:sql>
            <db:input-parameters>#[{enabled: vars.req.enabled, until: vars.req.until default null}]</db:input-parameters>
        </db:update>
        <db:insert config-ref="Db">
            <db:sql>insert into max.audit_log (actor, action, target, detail) values ('api', 'clock-auto', 'clock', cast(:detail as jsonb))</db:sql>
            <db:input-parameters>#[{detail: write({enabled: vars.req.enabled, until: vars.req.until default null}, 'application/json', {indent: false})}]</db:input-parameters>
        </db:insert>
        <set-payload value="#[output application/json --- {auto: vars.req.enabled, autoUntil: vars.req.until default null}]"/>
        <error-handler>
            <on-error-continue>
                <flow-ref name="error-body"/>
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- 自動で進める: clock.auto.interval ごとに 1 営業日。auto が false か、auto_until に着いていれば何もしない。
         手で進めている最中なら、その回は飛ばす -->
    <flow name="clock-auto" initialState="${clock.auto.state}">
        <scheduler>
            <scheduling-strategy>
                <fixed-frequency frequency="${clock.auto.interval}" startDelay="${clock.auto.interval}"/>
            </scheduling-strategy>
        </scheduler>
        <set-variable variableName="decisions" value="#[['問題なし', '深掘り', '保留', '当局報告']]"/>
        <db:select config-ref="Db" target="c">
            <db:sql>select auto, (auto_until is null or today &lt; auto_until) as more from max.business_clock</db:sql>
        </db:select>
        <choice>
            <when expression="#[vars.c[0].auto and vars.c[0].more]">
                <flow-ref name="clock-acquire"/>
                <choice>
                    <when expression="#[vars.acquired]">
                        <try>
                            <flow-ref name="advance-one-day"/>
                            <flow-ref name="clock-release"/>
                            <logger level="INFO" message="#[output text/plain --- 'clock advanced to ' ++ payload.date ++ ' (raised: ' ++ (payload.raised joinBy ',') ++ ')']"/>
                            <error-handler>
                                <on-error-continue>
                                    <flow-ref name="clock-release"/>
                                    <logger level="ERROR" message="#[output text/plain --- 'clock auto failed: ' ++ error.description]"/>
                                </on-error-continue>
                            </error-handler>
                        </try>
                    </when>
                </choice>
            </when>
        </choice>
    </flow>

    <!-- 試験用: 止まったプロセスが残した古い印を作る (admin.reset=true のときだけ) -->
    <flow name="admin-stale-busy">
        <http:listener config-ref="Http" path="/admin/stale-busy" allowedMethods="POST">
            <http:response statusCode="#[vars.status default 200]"/>
        </http:listener>
        <flow-ref name="auth"/>
        <choice>
            <when expression="#[p('admin.reset') != 'true']">
                <raise-error type="MAX:FORBIDDEN" description="Reset is turned off (admin.reset)"/>
            </when>
        </choice>
        <db:update config-ref="Db">
            <db:sql>update max.business_clock set busy = true, busy_since = now() - interval '11 minutes'</db:sql>
        </db:update>
        <set-payload value="#[output application/json --- {busy: true, stale: true}]"/>
        <error-handler>
            <on-error-continue>
                <flow-ref name="error-body"/>
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- 1 営業日進める。payload は {date, prices, trades, announcements, raised}。
         変数の名前は surveillance (vars.trades、vars.days など) と重ねない -->
    <sub-flow name="advance-one-day">
        <db:select config-ref="Db" target="clock">
            <db:sql>select to_char(today, 'YYYY-MM-DD') as today from max.business_clock</db:sql>
        </db:select>
        <set-variable variableName="day" value="#[max::market::nextBusinessDay(vars.clock[0].today as Date) as String]"/>
        <db:select config-ref="Db" target="prev">
            <db:sql>select code, close from max.prices where trade_date = cast(:d as date) order by code</db:sql>
            <db:input-parameters>#[{d: vars.clock[0].today}]</db:input-parameters>
        </db:select>
        <!-- 前の営業日 (いまの業務日) の公表は、今日の値動きに出る -->
        <db:select config-ref="Db" target="published">
            <db:sql>select code, price_move_pct from max.announcements where cast(published_at as date) = cast(:d as date)</db:sql>
            <db:input-parameters>#[{d: vars.clock[0].today}]</db:input-parameters>
        </db:select>
        <db:select config-ref="Db" target="customers">
            <db:sql>select customer_id, annual_income from max.customers order by customer_id</db:sql>
        </db:select>
        <db:select config-ref="Db" target="favorites">
            <db:sql>select distinct customer_id, code from max.trades order by customer_id, code</db:sql>
        </db:select>
        <db:select config-ref="Db" target="planned">
            <db:sql>select customer_id, code, side, qty from max.planned_orders where trade_date = cast(:d as date) order by customer_id, code, side</db:sql>
            <db:input-parameters>#[{d: vars.day}]</db:input-parameters>
        </db:select>
        <ee:transform>
            <ee:variables>
                <ee:set-variable variableName="dayPriceRows"><![CDATA[%dw 2.0
import dayPrices from max::market
output application/java
---
dayPrices(vars.day, vars.prev, {(vars.published map {($.code): $.price_move_pct})})]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <!-- 同じ ee:transform の中では、前の set-variable の値が見えない (実 Mule と同じ) ので分ける -->
        <!-- 今日の注文: 普段の売買と仕込んだ注文。約定は OMS (oms.url) が終値で作り、MQ で台帳に届く -->
        <ee:transform>
            <ee:variables>
                <ee:set-variable variableName="dayOrders"><![CDATA[%dw 2.0
import backgroundTrades from max::market
output application/java
var closes = {(vars.dayPriceRows map {($.code): $.close})}
var favs = (vars.favorites groupBy $.customer_id) mapObject ((rows, cid) -> {(cid): rows map $.code})
var background = backgroundTrades(vars.day, vars.customers, favs, closes) map {customer_id: $.customer_id, code: $.code, side: $.side, qty: $.qty, channel: $.channel}
var planted = vars.planned map {customer_id: $.customer_id, code: $.code, side: $.side, qty: $.qty, channel: 'ネット'}
---
background ++ planted]]></ee:set-variable>
                <ee:set-variable variableName="closes"><![CDATA[%dw 2.0
output application/java
---
{(vars.dayPriceRows map {($.code): $.close})}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <db:bulk-insert config-ref="Db">
            <db:bulk-input-parameters>#[vars.dayPriceRows]</db:bulk-input-parameters>
            <db:sql>insert into max.prices (code, trade_date, close, volume) values (:code, cast(:trade_date as date), :close, :volume)
                    on conflict (code, trade_date) do nothing</db:sql>
        </db:bulk-insert>
        <choice>
            <when expression="#[isEmpty(vars.dayOrders)]">
                <set-variable variableName="expected" value="#[[]]"/>
            </when>
            <otherwise>
                <!-- 試験では oms.url をこのアプリの偽の OMS (/admin/fake-oms) に向ける -->
                <http:request config-ref="Oms" method="POST" url="#[p('oms.url') ++ '/orders/day']">
                    <http:body><![CDATA[#[output application/json --- {date: vars.day, orders: vars.dayOrders, closes: vars.closes}]]]></http:body>
                    <http:headers><![CDATA[#[{'Authorization': 'Bearer ' ++ p('oms.key')}]]]></http:headers>
                </http:request>
                <set-variable variableName="expected" value="#[output application/java --- payload.fills map $.tradeId]"/>
            </otherwise>
        </choice>
        <flow-ref name="drain-fills"/>
        <set-variable variableName="fillResult" value="#[payload]"/>
        <db:select config-ref="Db" target="dayTrades">
            <db:sql>select trade_id, customer_id, code, side, qty, price from max.trades where trade_date = cast(:d as date) order by trade_id</db:sql>
            <db:input-parameters>#[{d: vars.day}]</db:input-parameters>
        </db:select>
        <!-- 今日の公表を announcements に移す -->
        <db:select config-ref="Db" target="todays">
            <db:sql>select announcement_id from max.planned_events where cast(published_at as date) = cast(:d as date) order by announcement_id</db:sql>
            <db:input-parameters>#[{d: vars.day}]</db:input-parameters>
        </db:select>
        <db:insert config-ref="Db">
            <db:sql>insert into max.announcements (announcement_id, code, published_at, kind, title, price_move_pct)
                    select announcement_id, code, published_at, kind, title, price_move_pct from max.planned_events
                    where cast(published_at as date) = cast(:d as date)</db:sql>
            <db:input-parameters>#[{d: vars.day}]</db:input-parameters>
        </db:insert>
        <db:update config-ref="Db">
            <db:sql>update max.business_clock set today = cast(:d as date)</db:sql>
            <db:input-parameters>#[{d: vars.day}]</db:input-parameters>
        </db:update>
        <db:insert config-ref="Db">
            <db:sql>insert into max.audit_log (actor, action, target, detail) values ('system:clock', 'advance', :d, cast(:detail as jsonb))</db:sql>
            <db:input-parameters>#[{d: vars.day, detail: write({prices: sizeOf(vars.dayPriceRows), orders: sizeOf(vars.dayOrders), trades: sizeOf(vars.dayTrades),
                announcements: vars.todays map $.announcement_id}, 'application/json', {indent: false})}]</db:input-parameters>
        </db:insert>
        <flow-ref name="surveillance"/>
        <set-payload value="#[{date: vars.day, prices: sizeOf(vars.dayPriceRows), trades: vars.dayTrades map ($.trade_id ++ ' ' ++ $.customer_id ++ ' ' ++ $.code ++ ' ' ++ $.side ++ ' ' ++ ($.qty as String) ++ ' @ ' ++ ($.price as String)),
            missingFills: vars.fillResult.missing,
            announcements: vars.todays map $.announcement_id, raised: vars.raised map $.alert_id}]"/>
    </sub-flow>
</mule>
